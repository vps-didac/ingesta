# Copia este archivo como secrets.env EN EL VPS, junto al docker-compose.yml,
# y rellénalo. secrets.env está en .gitignore: nunca se sube al repositorio y
# el despliegue no lo toca, porque git reset --hard no borra ficheros sin
# seguimiento.

# Hevy: requiere Hevy Pro. Clave en https://hevy.com/settings?developer
HEVY_API_KEY=

# Garmin Connect: solo hacen falta para el primer login y si el refresh token caduca.
# Tras "python -m ingest garmin-login" se usan los tokens de /data/garmin_tokens.
GARMIN_EMAIL=
GARMIN_PASSWORD=
